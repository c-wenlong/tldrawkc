#!/bin/sh
# Thin shim so the tool runs from a checkout, from a global `npm link`, or
# from `npx tldrawkc`. The real entry point is the compiled CLI, so
# `npm run build` has to have run at least once.
#
# $0 is resolved through symlinks first. npm exposes a package's bin as a
# symlink at node_modules/.bin/tldrawkc, and a bare `dirname "$0"` would then
# look for dist/ next to that symlink rather than next to this file. `readlink`
# without -f is used deliberately: -f is a GNU extension that older macOS does
# not have, so the loop below does the walking itself.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd) || exit 1

exec node "$dir/../dist/cli/index.js" "$@"
