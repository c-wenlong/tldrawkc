{
  "name": "tldrawkc",
  "version": "0.1.0",
  "description": "Draw diagrams on a real tldraw canvas from the command line, so a coding agent can draw, screenshot, look and iterate.",
  "license": "MIT",
  "author": "c-wenlong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-wenlong/tldrawkc.git"
  },
  "homepage": "https://github.com/c-wenlong/tldrawkc#readme",
  "bugs": {
    "url": "https://github.com/c-wenlong/tldrawkc/issues"
  },
  "keywords": [
    "tldraw",
    "diagram",
    "cli",
    "agent",
    "svg"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tldrawkc": "bin/tldrawkc"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:api && npm run build:page",
    "build:node": "tsc -p tsconfig.json",
    "build:api": "node --input-type=module -e \"import{buildApiReference}from'./dist/lib/api.js';const r=await buildApiReference();console.log('api: '+r.count+' helpers -> '+r.path)\"",
    "build:page": "vite build",
    "clean": "node --input-type=module -e \"import{rm}from'node:fs/promises';await rm('dist',{recursive:true,force:true})\"",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.page.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "doctor": "node dist/cli/index.js doctor"
  },
  "dependencies": {
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tldraw/assets": "^5.4.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldraw": "^5.4.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
